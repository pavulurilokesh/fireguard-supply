# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=3000

# REQUIRED: long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Where the SQLite database file is stored (defaults to ./fireguard.db)
DB_PATH=./fireguard.db

# Credentials used ONLY the very first time the database is created,
# to seed one admin account. Change this password after logging in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_password_123
